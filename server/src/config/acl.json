{
  "rules": [
    {
      "method": "GET",
      "path": "/api/health",
      "roles": [
        "public"
      ]
    },
    {
      "method": "POST",
      "path": "/api/auth",
      "roles": [
        "public"
      ]
    },
    {
      "method": "GET",
      "path": "/api/auth",
      "roles": [
        "admin",
        "customer"
      ]
    },
    {
      "method": "DELETE",
      "path": "/api/auth",
      "roles": [
        "admin",
        "customer"
      ]
    },
    {
      "method": "POST",
      "path": "/api/users",
      "roles": [
        "admin"
      ]
    },
    {
      "method": "PATCH",
      "path": "/api/users/me/password",
      "roles": [
        "admin",
        "customer"
      ]
    },
    {
      "method": "PATCH",
      "path": "/api/users/:id/password",
      "roles": [
        "admin"
      ]
    }
  ]
}